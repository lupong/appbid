# Coinbase Developer Platform credentials
# Get these from https://portal.cdp.coinbase.com
# Newer CDP portals label these as API key ID / API key secret.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Wallet secret/private key used by modern cdp-sdk wallet auth flows.
CDP_WALLET_SECRET=
CDP_PROJECT_ID=

# vLLM inference endpoint (OpenAI-compatible API exposed by vLLM on the MI300X)
VLLM_URL=http://localhost:8000/v1
# Default model is Qwen2.5-72B-Instruct (BF16) — requires the 192 GB MI300X to
# run alongside multiple LoRA adapters with KV-cache headroom. For local CPU /
# small-GPU iteration without LoRA, override to Qwen/Qwen2.5-7B-Instruct.
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# LoRA serving mode:
#   multi  — vLLM serves the base model + 5 per-lender LoRA adapters (default).
#            Underwriter routes each request to the lender's adapter by alias.
#   prompt — disable LoRA and fall back to per-lender system prompts against
#            the base model. Use this if multi-LoRA on ROCm is misbehaving.
LORA_MODE=multi

# Base Sepolia network
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Wallet IDs (populated by scripts/setup_wallets.py and stored in wallets.json)
MARKETPLACE_WALLET_ID=
RESERVE_WALLET_ID=

# Marketplace economics
INSERTION_FEE_USDC=0.10
WIN_PREMIUM_RATE=0.015
# Settlement + payment execution mode:
#   SETTLEMENT_MODE=live|stub
#   PAYMENT_MODE=live|stub
SETTLEMENT_MODE=live
PAYMENT_MODE=live

# X402 facilitator mode:
#   local  - deterministic in-process facilitator (default, dev/test)
#   remote - use HTTP facilitator endpoint (production-style verification)
X402_FACILITATOR_MODE=local
X402_FACILITATOR_URL=https://x402.org/facilitator

# Marketplace server
MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=8001

# DigitalOcean API token for scripted droplet provisioning.
# Create manually in DigitalOcean Control Panel -> API -> Personal access tokens.
# Keep secret and do not commit.
DO_API_TOKEN=

# SQLite database URL (async)
DATABASE_URL=sqlite+aiosqlite:///./appbid.db

# Logging
LOG_LEVEL=INFO
